# All keys are optional: without them the app runs in demo mode.
# Staging keys from https://staging.crossmint.com/console give Solana devnet for free.

# --- Crossmint client key: email login + embedded wallet (ck_staging_..., scope Wallets) ---
NEXT_PUBLIC_CROSSMINT_API_KEY=

# --- Crossmint server key: creates onramp orders, card -> USDC (sk_staging_..., never NEXT_PUBLIC) ---
CROSSMINT_SERVER_API_KEY=

# --- SPL demo tokens on Solana devnet (OFFICE-DEMO, test dollars, and vault shares) ---
# Filled by: node scripts/setup-devnet.mjs
DEMO_TOKEN_MINT=
DEMO_USD_MINT=
DEMO_VAULT_USDY_MINT=
DEMO_VAULT_KZGB_MINT=
DEMO_TOKEN_AUTHORITY_SECRET=
SOLANA_RPC_URL=

# --- RWA-DEMO / QUOTE-DEMO direct Meteora DLMM Devnet demo ---
# This flow is intentionally disabled until a developer has created a test-only
# pool. It fails closed for an empty, unknown, or non-Devnet cluster.
SOLANA_CLUSTER=devnet
ENABLE_DEVNET_DEMO=false
ENABLE_DEVNET_FAUCET=false
# A server-only JSON keypair path. Recommended location is ignored by Git:
DEVNET_PAYER_KEYPAIR_PATH=.secrets/devnet-payer.json
# Required only when the bootstrap must create missing mints and persist their
# public addresses into .env.local. Leave false for normal runs.
WRITE_DEVNET_DEMO_CONFIG=false
# Optional absolute regular-file target for public bootstrap output. Use only
# when a release's .env.local is deliberately a symlink to shared config.
DEVNET_PUBLIC_CONFIG_PATH=
# Filled only by: npm run devnet:bootstrap
DEVNET_QUOTE_MINT=
DEVNET_RWA_MINT=
DEVNET_METEORA_POOL=
DEVNET_RWA_LP_POSITION=
DEVNET_QUOTE_DECIMALS=6
# Bootstrap tuning, all test-only. The script verifies the live Devnet preset.
DEVNET_MIN_PAYER_SOL=0.5
DEVNET_INITIAL_QUOTE_PER_RWA=100
DEVNET_INITIAL_QUOTE_LIQUIDITY=1000000
DEVNET_INITIAL_RWA_LIQUIDITY=10000
DEVNET_LIQUIDITY_RANGE_BINS=10
# Illustrative scenario value only — never a live FX quote or payment rate.
DEMO_KZT_PER_QUOTE_TOKEN=500
DEMO_FUNDING_MAX_KZT=1000000
DEMO_FAUCET_MAX_QUOTE_TOKENS=1000
DEMO_FAUCET_DAILY_MAX_QUOTE_TOKENS=10000
DEMO_SWAP_SLIPPAGE_BPS=50

# --- Mercuryo on-ramp (backup): widget id from the Mercuryo dashboard ---
# Set HOST to the sandbox widget host from Mercuryo's docs while testing; empty = production.
NEXT_PUBLIC_MERCURYO_WIDGET_ID=
NEXT_PUBLIC_MERCURYO_WIDGET_HOST=

# --- Transak STAGING on-ramp: public staging key from dashboard.transak.com ---
NEXT_PUBLIC_TRANSAK_API_KEY=
# Server-only Transak staging secret. Never expose this with NEXT_PUBLIC_.
TRANSAK_API_SECRET=

# --- MoonPay buy/sell widget (sandbox keys from Developers → API Keys) ---
NEXT_PUBLIC_MOONPAY_PUBLISHABLE_KEY=
# Server-only URL signing secret. Never expose this with NEXT_PUBLIC_.
MOONPAY_SECRET_KEY=

# --- Transactional email (Gmail SMTP; optional locally) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
