# All keys are optional: without them the app runs in demo mode.
# Staging keys from https://staging.crossmint.com/console give Solana devnet for free.

# --- Crossmint client key: email login + embedded wallet (ck_staging_..., scope Wallets) ---
NEXT_PUBLIC_CROSSMINT_API_KEY=

# --- Crossmint server key: creates onramp orders, card -> USDC (sk_staging_..., never NEXT_PUBLIC) ---
CROSSMINT_SERVER_API_KEY=

# --- SPL demo tokens on Solana devnet (OFFICE-DEMO asset and test dollars) ---
# Filled by: node scripts/setup-devnet.mjs
DEMO_TOKEN_MINT=
DEMO_USD_MINT=
DEMO_TOKEN_AUTHORITY_SECRET=
SOLANA_RPC_URL=

# --- Mercuryo on-ramp (backup): widget id from the Mercuryo dashboard ---
# Set HOST to the sandbox widget host from Mercuryo's docs while testing; empty = production.
NEXT_PUBLIC_MERCURYO_WIDGET_ID=
NEXT_PUBLIC_MERCURYO_WIDGET_HOST=

# --- Transak STAGING on-ramp: public staging key from dashboard.transak.com ---
NEXT_PUBLIC_TRANSAK_API_KEY=
# Server-only Transak staging secret. Never expose this with NEXT_PUBLIC_.
TRANSAK_API_SECRET=

# --- MoonPay buy/sell widget (sandbox keys from Developers → API Keys) ---
NEXT_PUBLIC_MOONPAY_PUBLISHABLE_KEY=
# Server-only URL signing secret. Never expose this with NEXT_PUBLIC_.
MOONPAY_SECRET_KEY=
