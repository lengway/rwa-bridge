# Email-code sign-in requires AUTH_SESSION_SECRET and working SMTP_* / MAIL_FROM.
# The embedded wallet additionally requires the AUTH_JWT_* signing settings, a
# Crossmint staging client key, and owner-configured BYO JWT/JWKS + domain setup.
# The enabled Earn route is Solana Devnet only and has no monetary value.

# --- Email session and BYO JWT signing (server-only) ---
# Required for email-code sign-in.
AUTH_SESSION_SECRET=
# Required for the embedded-wallet BYO JWT.
# P-256 EC private-key PEM. Store PEM line breaks as literal \n in this value;
# keep the private key secret and never use NEXT_PUBLIC_ for it.
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_KID=
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
# Additional exact sandbox widget parent origins. No wildcard and no secrets.
# The trusted AUTH_JWT_ISSUER app origin is included automatically.
# For local checks: http://127.0.0.1:3201
WIDGET_ALLOWED_ORIGINS=

# --- Crossmint staging client key for embedded wallet (ck_staging_..., scope Wallets) ---
# Required for the embedded wallet, not for sending the email code itself.
NEXT_PUBLIC_CROSSMINT_API_KEY=

# --- Crossmint server key: legacy adapter only (never NEXT_PUBLIC) ---
# The Universal Earn gateway leaves it unused unless the legacy adapter gate is
# deliberately enabled after provider and eligibility review.
CROSSMINT_SERVER_API_KEY=

# --- Legacy app-controlled SPL Devnet test tokens ---
# Filled by: node scripts/setup-devnet.mjs
DEMO_TOKEN_MINT=
DEMO_USD_MINT=
DEMO_VAULT_USDY_MINT=
DEMO_VAULT_KZGB_MINT=
DEMO_TOKEN_AUTHORITY_SECRET=
SOLANA_RPC_URL=

# --- Kamino Lend / Solana Devnet (server-only execution gate) ---
# The integration verifies canonical Devnet genesis, program, market, reserve,
# mints, vault, authority, reserve state, and simulation before it returns an
# unsigned transaction to the user wallet. Never set this for Mainnet.
ENABLE_KAMINO_LEND_DEVNET=false
# Atomic Devnet USDC cap. It may only lower the hard one-USDC route limit.
KAMINO_LEND_DEVNET_MAX_AMOUNT_ATOMIC=1000000
# Optional storage path prefix. The app appends `.d` and stores action JSON
# files in that directory. Leave blank for the documented default.
KAMINO_ACTION_STORE_PATH=

# --- Legacy RWA / QUOTE Devnet Meteora route ---
# This route is disabled until a developer has created a test-only
# pool. It fails closed for an empty, unknown, or non-Devnet cluster.
SOLANA_CLUSTER=devnet
ENABLE_DEVNET_DEMO=false
ENABLE_DEVNET_FAUCET=false
# Legacy Earn test-token issuer. Disabled by default; requires an
# authenticated session and canonical Solana Devnet at runtime.
ENABLE_LEGACY_DEVNET_FAUCET=false
# Historic pre-Gateway inbound-transfer attribution. Keep disabled unless a
# controlled one-time Devnet migration is being reconciled.
ENABLE_LEGACY_EARN_IMPORT=false
# Keep all legacy card, Crossmint, Transak, MoonPay, and KZT/KZTE adapters
# disabled unless they have separately passed provider, eligibility, and
# deployment review. Set both flags only for that separately reviewed legacy
# path; the Universal Earn flow does not need them.
ENABLE_LEGACY_FIAT_ADAPTERS=false
NEXT_PUBLIC_ENABLE_LEGACY_FIAT_ADAPTERS=false
# A server-only JSON keypair path. Recommended location is ignored by Git:
DEVNET_PAYER_KEYPAIR_PATH=.secrets/devnet-payer.json
# Required only when the bootstrap must create missing mints and persist their
# public addresses into .env.local. Leave false for normal runs.
WRITE_DEVNET_DEMO_CONFIG=false
# Optional absolute regular-file target for public bootstrap output. Use only
# when a release's .env.local is deliberately a symlink to shared config.
DEVNET_PUBLIC_CONFIG_PATH=
# Filled only by: npm run devnet:bootstrap
# Set true only to use an existing, externally minted Devnet token (for example
# Devnet USDC) as the quote side. DEVNET_QUOTE_MINT becomes required and the
# bootstrap will never create, issue, or faucet that token.
DEVNET_EXTERNAL_QUOTE_MINT=false
# Optional display label for the configured external quote mint. Defaults to
# USDC in external mode and QUOTE-DEMO otherwise.
DEVNET_QUOTE_SYMBOL=
DEVNET_QUOTE_MINT=
DEVNET_RWA_MINT=
DEVNET_METEORA_POOL=
DEVNET_RWA_LP_POSITION=
DEVNET_QUOTE_DECIMALS=6
# Bootstrap tuning, all test-only. The script verifies the live Devnet preset.
DEVNET_MIN_PAYER_SOL=0.5
DEVNET_INITIAL_QUOTE_PER_RWA=100
DEVNET_INITIAL_QUOTE_LIQUIDITY=1000000
DEVNET_INITIAL_RWA_LIQUIDITY=10000
DEVNET_LIQUIDITY_RANGE_BINS=10
# Illustrative scenario value only — never a live FX quote or payment rate.
DEMO_KZT_PER_QUOTE_TOKEN=500
DEMO_FUNDING_MAX_KZT=1000000
DEMO_FAUCET_MAX_QUOTE_TOKENS=1000
DEMO_FAUCET_DAILY_MAX_QUOTE_TOKENS=10000
DEMO_SWAP_SLIPPAGE_BPS=50

# --- Legacy Mercuryo adapter (disabled by the flags above) ---
# A configured key does not establish provider, regional, or payment availability.
NEXT_PUBLIC_MERCURYO_WIDGET_ID=
NEXT_PUBLIC_MERCURYO_WIDGET_HOST=

# --- Legacy Transak adapter (disabled by the flags above) ---
NEXT_PUBLIC_TRANSAK_API_KEY=
# Server-only Transak staging secret. Never expose this with NEXT_PUBLIC_.
TRANSAK_API_SECRET=

# --- Legacy MoonPay adapter (disabled by the flags above) ---
NEXT_PUBLIC_MOONPAY_PUBLISHABLE_KEY=
# Server-only URL signing secret. Never expose this with NEXT_PUBLIC_.
MOONPAY_SECRET_KEY=

# --- Transactional email (required to request email sign-in codes) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
